    {
      "name": "3. Ventes réelles (RG1, RG2, RG3) avec ordonnance-service et user-service",
      "item": [
        {
          "name": "Préparer : vraie ordonnance (ordonnance-service)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gateway}}/api/ordonnances",
              "host": [
                "{{gateway}}"
              ],
              "path": [
                "api",
                "ordonnances"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientId\": \"patient-ahmed\",\n  \"medecinId\": \"medecin-karim\",\n  \"lignes\": [\n    {\n      \"medicamentId\": \"{{medicamentId}}\",\n      \"nomMedicament\": \"Test Postman {{suffixe}} mg\",\n      \"posologie\": \"1 par jour\",\n      \"dureeJours\": 2,\n      \"quantite\": 2\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('ordonnanceCode', pm.response.json().code);",
                  "pm.collectionVariables.set('ordonnanceId', pm.response.json().id);",
                  "pm.test('ordonnance VALIDEE', () => pm.expect(pm.response.json().statut).to.eql('VALIDEE'));"
                ]
              }
            }
          ]
