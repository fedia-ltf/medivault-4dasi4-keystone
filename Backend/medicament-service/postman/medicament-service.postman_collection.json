{
  "info": {
    "name": "MediVault - medicament-service (médicaments sensibles)",
    "description": "Tout passe par la Gateway ({{gateway}} = http://localhost:9000), comme le front.\nLancer les dossiers 0 à 4 dans l'ordre (Run collection) : la connexion Keycloak garde le jeton JWT, les identifiants créés sont gardés dans des variables.\nDonnées réelles : vraies pharmacies (user-service), vraie ordonnance (ordonnance-service), mise à jour de l'ordonnance par RabbitMQ (vente.sensible.enregistree).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// un suffixe unique par lancement : le médicament de test a un nom nouveau à chaque fois",
          "if (!pm.collectionVariables.get('suffixe')) { pm.collectionVariables.set('suffixe', Date.now() % 100000); }"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "0. Connexion (Keycloak, par la Gateway)",
      "item": [
        {
          "name": "Sans jeton : refusé par la Gateway (401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway}}/api/medicaments-sensibles",
              "host": [
                "{{gateway}}"
              ],
              "path": [
                "api",
                "medicaments-sensibles"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Connexion admin (jeton JWT)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gateway}}/api/auth/login",
              "host": [
                "{{gateway}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@medivault.tn\",\n  \"motDePasse\": \"{{motDePasse}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        }
      ]
    },
