{
  "info": {
    "name": "user-service (MediVault)",
    "description": "Connexion Keycloak, inscription, mot de passe oublié, comptes. Lancer avant : docker compose up -d + profil Spring keycloak. Par la Gateway plus tard : baseUrl = http://localhost:9000.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "motDePasseDemo",
      "value": "Medivault2026!"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "utilisateurId",
      "value": "patient-ahmed"
    }
  ],
  "item": [
    {
      "name": "Authentification",
      "item": [
        {
          "name": "Connexion - patient",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ahmed.benali@medivault.tn\",\n  \"motDePasse\": \"{{motDePasseDemo}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 + jeton', () => { pm.response.to.have.status(200); });",
                  "const s = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', s.accessToken);",
                  "pm.collectionVariables.set('refreshToken', s.refreshToken);",
                  "pm.test('role = ' + s.utilisateur.role, () => pm.expect(s.utilisateur.role).to.be.a('string'));"
                ]
              }
            }
          ]
        },
